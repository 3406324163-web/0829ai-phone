{
  "name": "ai-phone",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "queues": {
    "producers": [
      {
        "queue": "ai-message-queue",
        "binding": "AI_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "ai-message-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  }
}
